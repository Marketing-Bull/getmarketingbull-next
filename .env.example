# Lead form delivery (src/app/api/lead/route.ts). Set on Vercel → Project → Settings → Environment Variables.
# Any one of these is enough; both is better. With neither, leads only appear in Vercel function logs.

# GoHighLevel inbound webhook (or Zapier / Make / n8n). Receives the lead as JSON.
LEAD_WEBHOOK_URL=

# Resend: emails each lead to LEAD_NOTIFY_EMAIL from LEAD_FROM_EMAIL (domain must be verified in Resend).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@getmarketingbull.com
LEAD_FROM_EMAIL=leads@getmarketingbull.com

# GA4 measurement id. Defaults to the property hardcoded in src/lib/constants.ts, so
# analytics works on deploy with no configuration. Set this only to point a given
# environment at a different property (e.g. a staging property).
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container id (GTM-XXXXXXX). Optional and currently unset: GA4 is
# loaded directly instead. If you adopt a container, put your Ads/Meta tags in it —
# but do NOT also add a GA4 tag for the same property, or every pageview and event
# is counted twice. Move GA4 into the container and unset NEXT_PUBLIC_GA_ID instead.
NEXT_PUBLIC_GTM_ID=
