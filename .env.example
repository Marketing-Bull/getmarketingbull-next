# Lead form delivery (src/app/api/lead/route.ts). Set on Vercel → Project → Settings → Environment Variables.
# Any one of these is enough; both is better. With neither, leads only appear in Vercel function logs.

# GoHighLevel inbound webhook (or Zapier / Make / n8n). Receives the lead as JSON.
LEAD_WEBHOOK_URL=

# Resend: emails each lead to LEAD_NOTIFY_EMAIL from LEAD_FROM_EMAIL (domain must be verified in Resend).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@getmarketingbull.com
LEAD_FROM_EMAIL=leads@getmarketingbull.com

# Google Tag Manager container id (GTM-XXXXXXX). Set on Vercel → Project → Settings →
# Environment Variables. Until it is set, no GTM tag renders and every track() call
# is a no-op — so GA4, Ads and any pixel are configured inside GTM, not in this repo.
NEXT_PUBLIC_GTM_ID=
