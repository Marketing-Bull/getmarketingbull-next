# Lead form delivery (src/app/api/lead/route.ts). Set on Vercel → Project → Settings → Environment Variables.
# Every configured channel runs; the visitor sees success only if at least one returns 2xx. With none set,
# production returns an error (so no false conversion) and other environments just log the lead.

# GoHighLevel private integration token: creates a Contact tagged `mb-site-lead`.
LEAD_GHL_API_KEY=
# GHL sub-account (location) id. Defaults to the Marketing Bull sub-account.
LEAD_GHL_LOCATION_ID=

# Generic webhook (Zapier / Make / n8n). Receives the lead as JSON.
LEAD_WEBHOOK_URL=

# Resend: emails each lead to LEAD_NOTIFY_EMAIL from LEAD_FROM_EMAIL (domain must be verified in Resend).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@getmarketingbull.com
LEAD_FROM_EMAIL=leads@getmarketingbull.com

# GA4 measurement id for the direct gtag snippet in src/app/layout.tsx. Defaults to the
# property hardcoded in src/lib/constants.ts (an empty value also falls back to it), so
# analytics works on deploy with no configuration. Set this only to point a given
# environment at a different property (e.g. a staging property). It does not turn GA off.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container id (GTM-XXXXXXX). Optional and currently unset: GA4 is
# loaded directly instead. This is the switch between the two paths: setting it renders
# GTM AND removes the direct gtag snippet, so GA4 must then be added as a tag inside
# the container (or GA collects nothing). Leave it unset to keep the direct snippet.
NEXT_PUBLIC_GTM_ID=
